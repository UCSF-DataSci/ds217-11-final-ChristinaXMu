    "# Import libraries\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import os\n",
    "from sklearn.linear_model import LinearRegression\n",
    "from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score\n",
    "import xgboost as xgb\n",
    "\n",
    "# Ensure output directory exists\n",
    "os.makedirs(\"output\", exist_ok=True)\n",
    "\n",
    "# Load Q6 train/test data\n",
    "X_train = pd.read_csv('output/q6_X_train.csv')\n",
    "X_test  = pd.read_csv('output/q6_X_test.csv')\n",
    "y_train = pd.read_csv('output/q6_y_train.csv').squeeze()  # Convert to Series\n",
    "y_test  = pd.read_csv('output/q6_y_test.csv').squeeze()\n",
    "\n",
    "print(f\"Training set: {X_train.shape}\")\n",
    "print(f\"Test set: {X_test.shape}\")\n",
    "\n",
    "# Train Models\n",
    "# Linear Regression\n",
    "lr_model = LinearRegression()\n",
    "lr_model.fit(X_train, y_train)\n",
    "\n",
    "lr_train_pred = lr_model.predict(X_train)\n",
    "lr_test_pred  = lr_model.predict(X_test)\n",
    "\n",
    "# XGBoost Regressor\n",
    "xgb_model = xgb.XGBRegressor(n_estimators=100, max_depth=6, random_state=42)\n",
    "xgb_model.fit(X_train, y_train)\n",
    "\n",
    "xgb_train_pred = xgb_model.predict(X_train)\n",
    "xgb_test_pred  = xgb_model.predict(X_test)\n",
    "\n",
    "# Evaluate Model Performance\n",
    "def compute_metrics(y_true, y_pred):\n",
    "    r2 = r2_score(y_true, y_pred)\n",
    "    rmse = np.sqrt(mean_squared_error(y_true, y_pred))\n",
    "    mae = mean_absolute_error(y_true, y_pred)\n",
    "    return r2, rmse, mae\n",
    "\n",
    "# Linear Regression metrics\n",
    "lr_train_r2, lr_train_rmse, lr_train_mae = compute_metrics(y_train, lr_train_pred)\n",
    "lr_test_r2,  lr_test_rmse,  lr_test_mae  = compute_metrics(y_test, lr_test_pred)\n",
    "\n",
    "# XGBoost metrics\n",
    "xgb_train_r2, xgb_train_rmse, xgb_train_mae = compute_metrics(y_train, xgb_train_pred)\n",
    "xgb_test_r2,  xgb_test_rmse,  xgb_test_mae  = compute_metrics(y_test, xgb_test_pred)\n",
    "\n",
    "# Save Predictions\n",
    "predictions_df = pd.DataFrame({\n",
    "    'actual': y_test.values,\n",
    "    'predicted_linear': lr_test_pred,\n",
    "    'predicted_xgboost': xgb_test_pred\n",
    "})\n",
    "predictions_df.to_csv('output/q7_predictions.csv', index=False)\n",
    "\n",
    "# Save Model Metrics\n",
    "with open('output/q7_model_metrics.txt', 'w') as f:\n",
    "    f.write(\"MODEL PERFORMANCE METRICS\\n========================\\n\\n\")\n",
    "    \n",
    "    f.write(\"LINEAR REGRESSION:\\n\")\n",
    "    f.write(f\"  Train R²: {lr_train_r2:.4f}\\n\")\n",
    "    f.write(f\"  Test R²:  {lr_test_r2:.4f}\\n\")\n",
    "    f.write(f\"  Train RMSE: {lr_train_rmse:.4f}\\n\")\n",
    "    f.write(f\"  Test RMSE:  {lr_test_rmse:.4f}\\n\")\n",
    "    f.write(f\"  Train MAE: {lr_train_mae:.4f}\\n\")\n",
    "    f.write(f\"  Test MAE:  {lr_test_mae:.4f}\\n\\n\")\n",
    "    \n",
    "    f.write(\"XGBOOST:\\n\")\n",
    "    f.write(f\"  Train R²: {xgb_train_r2:.4f}\\n\")\n",
    "    f.write(f\"  Test R²:  {xgb_test_r2:.4f}\\n\")\n",
    "    f.write(f\"  Train RMSE: {xgb_train_rmse:.4f}\\n\")\n",
    "    f.write(f\"  Test RMSE:  {xgb_test_rmse:.4f}\\n\")\n",
    "    f.write(f\"  Train MAE: {xgb_train_mae:.4f}\\n\")\n",
    "    f.write(f\"  Test MAE:  {xgb_test_mae:.4f}\\n\")\n",
    "\n",
    "# Feature Importance (XGBoost)\n",
    "feature_importance = pd.DataFrame({\n",
    "    'feature': X_train.columns,\n",
    "    'importance': xgb_model.feature_importances_\n",
    "}).sort_values('importance', ascending=False)\n",
    "\n",
    "feature_importance.to_csv('output/q7_feature_importance.csv', index=False)\n",
    "\n",
    "# Print Confirmation\n",
    "print(\"Q7 artifacts saved:\")\n",
    "print(\" - output/q7_predictions.csv\")\n",
    "print(\" - output/q7_model_metrics.txt\")\n",
    "print(\" - output/q7_feature_importance.csv\")\n"
